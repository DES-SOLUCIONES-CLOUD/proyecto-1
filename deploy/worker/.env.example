# Configuración del Worker Server en GCP. La genera deploy/gcp/generar-env.sh
# (deploy/worker/.env, ignorado por git). Sin secretos, solo sus nombres en
# Secret Manager: ver deploy/web/.env.example.

PROYECTO_GCP=mi-proyecto-mooc
REGISTRO=us-central1-docker.pkg.dev/mi-proyecto-mooc/mooc

# --- Base de datos (Cloud SQL, IP privada) -----------------------------------
DB_HOST=10.30.0.3
DB_USER=mooc
DB_NAME=mooc
SECRETO_DB_PASSWORD=mooc-bd-password
# Pool del worker. Vacío = 5 (en el compose): con 2 trabajos simultáneos no
# hacen falta más, y lo que no usa queda para la API.
DB_MAX_CONNS=

# --- Redis -------------------------------------------------------------------
# IP interna de ESTA VM (salida ip_worker). Redis se publica solo en ella, no
# en 0.0.0.0: aunque la VM no tiene IP externa, así tampoco escucha en
# interfaces que se añadan después.
REDIS_BIND_IP=10.10.2.10

# --- Cloud Storage -----------------------------------------------------------
S3_BUCKET=mi-proyecto-mooc-mooc-objetos
S3_BUCKET_HLS=mi-proyecto-mooc-mooc-hls
# Clave HMAC de la cuenta de servicio del Worker (salida
# hmac_worker_access_id), distinta de la de la API.
S3_ACCESS_KEY=GOOG1E_IDENTIFICADOR_DE_EJEMPLO
SECRETO_S3_SECRET_KEY=mooc-hmac-worker-secret

# --- Procesamiento -----------------------------------------------------------
# Trabajos simultáneos. 2 y no el 5 local: en 2 GB, dos FFmpeg o un FFmpeg y
# un LibreOffice ya rondan el límite, y la e2-small sostiene 0,5 vCPU (con
# ráfaga), así que más trabajos a la vez no terminan antes. 1 si aparecen
# reinicios por memoria. Es un parámetro del experimento de capacidad: fijo
# en cada corrida y registrado en el informe.
WORKER_CONCURRENCY=2
