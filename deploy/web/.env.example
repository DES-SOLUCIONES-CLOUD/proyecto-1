# Configuración del Web Server en GCP. La genera deploy/gcp/generar-env.sh a
# partir de las salidas de Terraform (deploy/web/.env, ignorado por git) y
# desplegar-vm.sh la instala en /opt/mooc/config/web.env (root, 600).
#
# No contiene secretos, solo sus NOMBRES en Secret Manager: en-vm.sh los lee
# en la VM con la cuenta de servicio del Web al desplegar y no los escribe en
# disco. El endpoint, la región y las opciones fijas de Cloud Storage están en
# el compose, no aquí.

PROYECTO_GCP=mi-proyecto-mooc
# Prefijo de las imágenes en Artifact Registry (salida `registro`). La
# etiqueta es el commit desplegado (VERSION), la fija en-vm.sh.
REGISTRO=us-central1-docker.pkg.dev/mi-proyecto-mooc/mooc

# --- Base de datos (Cloud SQL, IP privada) -----------------------------------
# La API compone DATABASE_URL con estos valores y sslmode=require.
DB_HOST=10.30.0.3
DB_USER=mooc
DB_NAME=mooc
SECRETO_DB_PASSWORD=mooc-bd-password
# Pool de la API. Vacío = 20. API + worker (5) + migrate y psql tienen que
# caber en max_connections: 100 en db-custom-1-3840, 50 en db-g1-small.
DB_MAX_CONNS=

# --- Redis (en el Worker Server) ---------------------------------------------
# IP interna fija del Worker (salida ip_worker). Sin contraseña: el firewall
# solo admite 6379 desde la cuenta de servicio de esta VM.
REDIS_ADDR=10.10.2.10:6379

# --- Cloud Storage -----------------------------------------------------------
S3_BUCKET=mi-proyecto-mooc-mooc-objetos
S3_BUCKET_HLS=mi-proyecto-mooc-mooc-hls
# Identificador de la clave HMAC de la cuenta de servicio de la API (salida
# hmac_web_access_id). No es secreto por sí solo; el secreto va en Secret
# Manager.
S3_ACCESS_KEY=GOOG1E_IDENTIFICADOR_DE_EJEMPLO
SECRETO_S3_SECRET_KEY=mooc-hmac-web-secret

# --- Acceso público ----------------------------------------------------------
# Origen HTTPS (salida url_publica). Se usa en los enlaces de los correos y
# como origen permitido por CORS en la API; coincide con el CORS de los
# buckets, que Terraform fija a este mismo origen.
PUBLIC_BASE_URL=https://203.0.113.10.sslip.io
# Nombre para el certificado (salida host_web) y correo de aviso de Let's
# Encrypt (caducidad, incidentes). Ver deploy/web/certificado.sh.
TLS_HOST=203.0.113.10.sslip.io
TLS_EMAIL=

# --- Aplicación --------------------------------------------------------------
SMTP_FROM=no-reply@mooc.local
# Vacío = 10 intentos por IP y minuto, el valor de producción. Subirlo solo
# para una corrida de carga concreta, y registrarlo en el informe.
AUTH_RATE_LIMIT_PER_MINUTE=
BADGE_KEY_ID=mooc-badges-1
ISSUER_NAME=Plataforma MOOC
SECRETO_BADGE_SIGNING_KEY=mooc-badge-signing-key
# Administrador inicial: se crea en el primer arranque si no existe ninguno,
# con la contraseña del secreto de abajo (verla: gcloud secrets versions
# access latest --secret mooc-admin-password). Retirar el correo tras el
# primer arranque y volver a desplegar.
ADMIN_EMAIL=
SECRETO_ADMIN_PASSWORD=mooc-admin-password

# Frontend en el mismo origen que la API. Quitar la línea libera ~384 MiB
# en una prueba de carga; publicar.sh lo construye igual.
COMPOSE_PROFILES=frontend

# Semilla de carga (en-vm.sh sembrar). 0 = la inscripción la hace k6
# (Escenario 1). Por defecto 1, como en Etapa 1.
# SEED_STUDENTS=400
# SEED_TEACHERS=3
# SEED_ENROLL=0
