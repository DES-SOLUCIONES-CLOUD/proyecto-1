# Base de la API vista desde el navegador. Con el rewrite de next.config.ts,
# el valor por defecto mantiene todo en el mismo origen.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Origen publico del frontend (URLs de verificacion de insignias, metadatos).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de la API vista desde el proceso de Next.js (SSR y rewrites).
# En Docker Compose apunta al nombre del servicio: http://api:8080/api/v1
API_INTERNAL_URL=http://localhost:8080/api/v1
