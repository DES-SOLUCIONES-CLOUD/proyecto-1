POSTGRES_DB=mooc
POSTGRES_USER=mooc
POSTGRES_PASSWORD=mooc

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=mooc

# Puertos del host para MinIO (9000/9001 suelen estar ocupados por otros proyectos)
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101

# Host por el que el NAVEGADOR alcanza el almacén de objetos. Por defecto se
# deriva de MINIO_API_PORT (localhost:9100), que es lo correcto en local.
# Importa porque la API habla con MinIO como "minio:9000", un nombre que solo
# resuelve dentro de la red del compose: una URL prefirmada contra ese host
# llega al navegador y muere con ERR_NAME_NOT_RESOLVED. La firma SigV4 cubre
# el Host, así que hay que firmar contra el host público, no reescribir la URL.
# En un despliegue real: el dominio del almacén o del CDN, con S3_PUBLIC_USE_SSL=true.
# S3_PUBLIC_ENDPOINT=localhost:9100
# S3_PUBLIC_USE_SSL=false

# Origen permitido por MinIO para las peticiones del navegador (subida
# prefirmada y lectura del HLS por hls.js). En producción, el origen real.
MINIO_CORS_ALLOW_ORIGIN=*

# Escaneo antimalware de las cargas. Vacío deja operando el escáner integrado,
# que reconoce el vector de prueba estándar (EICAR) y los formatos ejecutables,
# pero no sustituye a un antivirus con firmas al día. Con la dirección de un
# clamd (por ejemplo "clamav:3310") se usan los dos: primero el integrado y
# después ClamAV. Si clamd está configurado y no responde, la carga se rechaza
# en vez de darse por limpia.
#
# Para levantar ClamAV en local: docker compose --profile antivirus up
# CLAMAV_ADDR=clamav:3310
CLAMAV_ADDR=

# URL pública del frontend, usada en enlaces de correo (verificación, reseteo)
# y como origen permitido por CORS.
PUBLIC_BASE_URL=http://localhost:3000

# Administrador inicial (opcional). Si se define, la API lo crea en el primer
# arranque si aún no existe ningún administrador. Retira estas variables tras
# el primer arranque en un entorno real.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Clave privada Ed25519, en base64, con que se firman las credenciales
# Open Badges 3.0. Vacía desactiva la credencial portatil: las insignias
# siguen siendo verificables por su URL publica.
#
# No se genera una clave al vuelo como sustituto: cada reinicio produciria
# otra y lo firmado antes dejaria de verificarse.
#
#   openssl genpkey -algorithm ed25519 -outform DER | base64 -w0
BADGE_SIGNING_KEY=
# Identifica la clave dentro del JWKS, para rotarla sin invalidar de golpe
# todo lo firmado antes.
BADGE_KEY_ID=mooc-badges-1
# Organizacion que figura como emisora de las credenciales.
ISSUER_NAME=Plataforma MOOC
