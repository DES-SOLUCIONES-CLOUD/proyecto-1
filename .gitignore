# Python
__pycache__/
*.py[cod]

# Go
backend/bin/
*.exe
*.test
*.out
# Binarios que deja `go build ./cmd/...` en la raíz del módulo: toman el
# nombre del paquete, así que no hay un patrón que los cubra por extensión.
backend/api
backend/worker
backend/seed

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/
frontend/next-env.d.ts
frontend/*.tsbuildinfo
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions
frontend/.vercel
# Resultados de Playwright: informes, trazas y vídeos de una corrida concreta.
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/
frontend/.playwright/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Entornos y secretos
.env
.env.local
.env.*.local
*.pem

# Terraform: el estado guarda en claro las contraseñas y claves que genera,
# y terraform.tfvars lleva el proyecto y el correo del administrador. El
# estado vive en el bucket remoto (versions.tf); aquí no se versiona nada de
# eso. El .terraform.lock.hcl sí se podría versionar, pero CI lo guarda con el
# plan (desplegar-gcp.yml), así que también queda fuera.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl
# Código de la Cloud Function armado por deploy/gcp/preparar-funcion.sh
# (fuente + FFmpeg estático) y el zip que sube Terraform.
deploy/gcp/terraform/.build/
# Estado local entre scripts de deploy/gcp (último tag, último export).
deploy/gcp/.estado

# Sistema operativo / editores
.DS_Store
Thumbs.db
.vscode/
.idea/

# Material de apoyo, no entregable
# Guiones y notas de preparación: ayudan a grabar y ensayar, pero no forman
# parte del sistema ni de su documentación técnica.
docs/video-sustentacion.md
NOTAS.md
notas/


.cursor/
.cursorrules
.cursorignore
.claude/
CLAUDE.md
AGENTS.md
.aider*
.specstory/
.continue/
.windsurfrules
.github/copilot-instructions.md
*.canvas.tsx
prompts/
.prompts/

# Clave del admin del SonarQube local (deploy/sonarqube/analizar.sh)
deploy/sonarqube/.clave-admin
